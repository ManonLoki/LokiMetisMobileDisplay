  "cards": [
    {
      "dot": "cyan",
      "title": "共享协议，不共享运行时",
      "items": [
        "Rust 源码来自桌面仓库，构建时分别编入 Android 与 iPhone。",
        "Android 经 JNI，iPhone 经 C ABI；socket 与存储仍属平台。",
        "Watch / Widget 的只读 HTTP 使用原生加密客户端。"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与缓存",
      "items": [
        "移动端只展示桌面当日快照，不重新核算总量。",
        "Android 实时主面板只在内存；Widget 单独保存摘要。",
        "Apple App / Widget 共用 App Group；Watch 自有私有缓存。"
      ]
    },
    {
      "dot": "amber",
      "title": "前后台所有权",
      "items": [
        "Android 前台服务与悬浮窗复用同一应用连接。",
        "Android JobService 独立读摘要，不新建常驻实时引擎。",
        "Apple 普通后台关闭长连，系统可调度短时摘要刷新。"
      ]
    },
    {
      "dot": "rose",
      "title": "配对与权限",
      "items": [
        "发现电脑不代表授信；首次四位码配对后保存平台凭据。",
        "Watch 配对经 iPhone；正文图片经手机，摘要可独立刷新。",
        "只读摘要不包含正文图片，后台间隔是申请而非保证。"
      ]
    }
  ]
