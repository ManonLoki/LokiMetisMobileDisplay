<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/metris_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/metris_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/metris_widget_title"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="10dp"
                android:autoSizeStepGranularity="1dp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/metris_widget_title"
                android:textColor="#DCEBF0" />

            <TextView
                android:id="@+id/metris_widget_day"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="9dp"
                android:autoSizeStepGranularity="1dp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/metris_widget_waiting_day"
                android:textColor="#9BB1BC" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/metris_widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/metris_widget_refresh_background"
            android:contentDescription="@string/metris_widget_refresh"
            android:padding="14dp"
            android:src="@drawable/metris_widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/metris_widget_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="36sp"
        android:autoSizeMinTextSize="16dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/metris_widget_no_data"
        android:textColor="#64E5E3" />

    <TextView
        android:id="@+id/metris_widget_exact"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/metris_widget_waiting_data"
        android:textColor="#C0D1DA" />

    <TextView
        android:id="@+id/metris_widget_quota"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#40C057"
        android:visibility="gone" />

    <TextView
        android:id="@+id/metris_widget_quality"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeMinTextSize="9dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/metris_widget_open_to_pair"
        android:textColor="#F4C675" />

    <TextView
        android:id="@+id/metris_widget_hooks"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="9dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/metris_widget_waiting_hooks"
        android:textColor="#DCEBF0" />

    <TextView
        android:id="@+id/metris_widget_synced"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/metris_widget_never_synced"
        android:textColor="#9BB1BC" />
</LinearLayout>
