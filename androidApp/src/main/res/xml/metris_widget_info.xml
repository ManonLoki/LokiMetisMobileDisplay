<?xml version="1.0" encoding="utf-8"?>
<!-- 组件不使用框架固定更新周期；15 分钟建议刷新由 AndroidRefreshScheduler 的系统任务申请。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/metris_widget_description"
    android:initialLayout="@layout/metris_widget"
    android:minWidth="130dp"
    android:minHeight="196dp"
    android:minResizeWidth="130dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/metris_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
