// 本机或命令行提供开发团队；此值同时参与签名、Bundle ID 与 App Group 命名。
TEAM_ID=

PRODUCT_NAME=LokiMetrisDisplay
LOKI_APP_BUNDLE_IDENTIFIER=com.manonloki.lokimetrisdisplay.LokiMetrisDisplay$(TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER=$(LOKI_APP_BUNDLE_IDENTIFIER)
LOKI_WIDGET_APP_GROUP=group.$(LOKI_APP_BUNDLE_IDENTIFIER)

// App、Widget、Watch 共用 Apple 构建号；不要求与 Android versionCode 相同。
CURRENT_PROJECT_VERSION=15
MARKETING_VERSION=1.0.7
